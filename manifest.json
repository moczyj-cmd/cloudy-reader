{
  "manifest_version": 3,
  "name": "Cloudy Reader",
  "version": "1.2.0",
  "description": "100% Local, Zero-Footprint Visual Ergonomics, Typography Suite, and Ambient Lighting Utility.",
  "permissions": ["storage", "activeTab", "tabs", "contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cloudy Reader"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["index.css"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*", "legal.html", "gemini-svg.png"],
      "matches": ["<all_urls>"]
    }
  ]
}