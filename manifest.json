{
  "manifest_version": 3,
  "name": "Cloudy Reader",
  "version": "1.8.0",
  "description": "100% Local, Zero-Footprint Visual Ergonomics, Typography Suite, and Ambient Lighting Utility.",
  "permissions": ["storage", "activeTab", "tabs", "contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'none';"
  },
  "icons": {
    "16": "cloudy-icon.png",
    "32": "cloudy-icon.png",
    "48": "cloudy-icon.png",
    "128": "cloudy-icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cloudy Reader",
    "default_icon": "cloudy-icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["index.css"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*", "legal.html", "cloudy-icon.png"],
      "matches": ["<all_urls>"]
    }
  ]
}