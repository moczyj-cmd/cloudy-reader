{
  "manifest_version": 3,
  "name": "Cloudy Reader",
  "version": "1.1",
  "description": "Sensory Shielding & Web Environment Optimization",
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "gemini-svg.png",
    "48": "gemini-svg.png",
    "128": "gemini-svg.png"
  },
  "permissions": ["storage", "contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "css": ["index.css"],
      "js": ["content.js"]
    }
  ]
}